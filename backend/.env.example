PORT=4000
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
FRONTEND_URL=https://welearn.ma
CORS_ORIGIN=http://localhost:3000,https://welearn.ma,https://www.welearn.ma


# Paiement CMI (3D Pay Hosting). Si une variable manque, /api/payments est
# desactive (les autres routes continuent de fonctionner).
CMI_CLIENT_ID=your_cmi_client_id
CMI_STORE_KEY=your_cmi_store_key
CMI_GATEWAY_URL=https://your-cmi-gateway-host/fim/est3Dgate
API_PUBLIC_URL=https://api.your-domain.example
SITE_URL=https://your-domain.example

# E-mails (formulaire de contact, justificatifs etudiants, codes). Si SMTP_HOST,
# SMTP_USER ou SMTP_PASS manque, les e-mails ne partent pas (erreur journalisee).
SMTP_HOST=smtp.your-mail-host.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@your-domain.example
CONTACT_RECIPIENT=contact@your-domain.example
